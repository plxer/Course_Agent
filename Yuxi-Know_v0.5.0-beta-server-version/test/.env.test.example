# 测试环境配置
# 复制并重命名为 .env.test 用于测试

# 测试服务器地址
TEST_BASE_URL=http://localhost:5050

# 测试用户凭据（集成测试、course_stress_test.py 登录 LLM 接口）
# 也可用根目录 .env 中的 YUXI_SUPER_ADMIN_NAME / YUXI_SUPER_ADMIN_PASSWORD
TEST_USERNAME=
TEST_PASSWORD=

# 批量注册压力测试账号时的默认密码（见 test/course_stress_users.py register）
# STRESS_TEST_PASSWORD=StressTest1!

# 多用户：uv run python test/run_course_stress_multi.py -a test/course_stress_accounts.json -- --llm-concurrency 2
#
# 压测时建议：docker compose -f docker-compose.yml -f docker-compose.stress.yml up -d（关闭 api --reload）

# 其他测试相关配置
# ENABLE_DEBUG=true